<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121212"
    android:paddingHorizontal="32dp"
    android:paddingTop="12dp"
    android:paddingBottom="40dp">

    <View
        android:id="@+id/dragHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#40FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"/>

    <!-- Large Square Album Art -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAlbum"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="20dp"
        app:cardBackgroundColor="#282828"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/dragHandle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp">

        <ImageView
            android:id="@+id/modalAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_report_image"/>
    </androidx.cardview.widget.CardView>

    <!-- Info Section -->
    <TextView
        android:id="@+id/modalSongTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Título da Música"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:ellipsize="marquee"
        android:singleLine="true"
        app:layout_constraintTop_toBottomOf="@id/cardAlbum"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnQueue"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"/>

    <TextView
        android:id="@+id/modalArtistName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Artista"
        android:textColor="#B3B3B3"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/modalSongTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnQueue"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"/>

    <ImageButton
        android:id="@+id/btnQueue"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_agenda"
        android:scaleType="fitCenter"
        android:padding="8dp"
        android:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="@id/modalSongTitle"
        app:layout_constraintBottom_toBottomOf="@id/modalArtistName"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Progress Bar -->
    <SeekBar
        android:id="@+id/modalSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:progressTint="#1DB954"
        android:thumbTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/modalArtistName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:splitTrack="false"/>

    <TextView
        android:id="@+id/txtCurrentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:00"
        android:textColor="#B3B3B3"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/modalSeekBar"
        app:layout_constraintStart_toStartOf="@id/modalSeekBar"/>

    <TextView
        android:id="@+id/txtTotalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:00"
        android:textColor="#B3B3B3"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/modalSeekBar"
        app:layout_constraintEnd_toEndOf="@id/modalSeekBar"/>

    <!-- Playback Controls -->
    <LinearLayout
        android:id="@+id/controlsLayout"
        android:layout_width="328dp"
        android:layout_height="79dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtCurrentTime">

        <ImageButton
            android:id="@+id/btnShuffle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_share"
            android:tint="#B3B3B3" />

        <ImageButton
            android:id="@+id/modalBtnPrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/modalBtnPlayPause"
            android:layout_width="79dp"
            android:layout_height="86dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/modalBtnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnRepeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#B3B3B3" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
