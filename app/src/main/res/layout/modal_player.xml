<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:paddingHorizontal="32dp"
    android:paddingTop="12dp"
    android:paddingBottom="40dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#40FFFFFF"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"/>

    <!-- Large Square Album Art -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        app:cardCornerRadius="24dp"
        app:cardElevation="20dp"
        app:cardBackgroundColor="#282828"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/modalAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_report_image"/>
    </androidx.cardview.widget.CardView>

    <!-- Info and Queue -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modalSongTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Título da Música"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:ellipsize="marquee"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/modalArtistName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Artista"
                android:textColor="#B3B3B3"
                android:textSize="18sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnQueue"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_agenda"
            android:tint="#FFFFFF"/>
    </LinearLayout>

    <!-- Progress Bar -->
    <SeekBar
        android:id="@+id/modalSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="#1DB954"
        android:thumbTint="#FFFFFF"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:splitTrack="false"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">
        <TextView
            android:id="@+id/txtCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#B3B3B3"
            android:textSize="14sp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:id="@+id/txtTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#B3B3B3"
            android:textSize="14sp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>

    <!-- Playback Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <ImageButton
            android:id="@+id/btnShuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_share"
            android:tint="#B3B3B3" />

        <ImageButton
            android:id="@+id/modalBtnPrev"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:scaleType="fitCenter"
            android:tint="#FFFFFF"/>

        <ImageButton
            android:id="@+id/modalBtnPlayPause"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_play"
            android:scaleType="fitCenter"
            android:tint="#FFFFFF"/>

        <ImageButton
            android:id="@+id/modalBtnNext"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            android:scaleType="fitCenter"
            android:tint="#FFFFFF"/>

        <ImageButton
            android:id="@+id/btnRepeat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#B3B3B3" />
    </LinearLayout>

</LinearLayout>
